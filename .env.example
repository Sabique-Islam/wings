# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional — only needed if you use the legacy project-id helper
# VITE_SUPABASE_PROJECT_ID=your-project-id

# Payments (optional)
# VITE_DODO_MODE=test
# VITE_DODO_PUBLIC_KEY=

# ── Email (Resend) — Edge Function secrets only, NOT VITE_ ──
# Docs: https://resend.com/docs/send-with-nodejs
# 1. Verify domain mail.wings.nopejs.me at https://resend.com/domains
# 2. Create API key → RESEND_API_KEY
# 3. supabase secrets set --env-file supabase/functions/.env
# 4. Deploy auth-send-email + send-email, enable Auth Send Email hook
# See supabase/functions/env.example
