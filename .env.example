# Supabase (required — set these in Vercel → Project → Settings → Environment Variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Vercel: add the same VITE_* vars for Production (and Preview if needed).
#
# Supabase Auth → URL Configuration:
#   Site URL: https://wings.nopejs.me
#   Redirect URLs (allow list):
#     http://localhost:8080/auth/callback
#     https://wings.nopejs.me/auth/callback
#
# Google OAuth (Supabase Auth → Providers → Google):
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web)
#      Authorized JavaScript origins:
#        http://localhost:8080
#        https://wings.nopejs.me
#      Authorized redirect URIs (Supabase only — not your app /auth/callback):
#        https://dxtaopkivhfrjrqvjdbl.supabase.co/auth/v1/callback
#   2. Supabase → Authentication → Providers → Google: enable, paste Client ID + Client Secret
#   3. Save. Sign-in uses PKCE and returns to /auth/callback on your app origin.
#
# Disable the "Send Email" auth hook unless auth-send-email is deployed with Resend.

# Optional — only needed if you use the legacy project-id helper
# VITE_SUPABASE_PROJECT_ID=your-project-id

# Payments (optional)
# VITE_DODO_MODE=test
# VITE_DODO_PUBLIC_KEY=

# ── Email (Resend) — Edge Function secrets only, NOT VITE_ ──
# Docs: https://resend.com/docs/send-with-nodejs
# 1. Verify domain mail.wings.nopejs.me at https://resend.com/domains
# 2. Create API key → RESEND_API_KEY
# 3. supabase secrets set --env-file supabase/functions/.env
# 4. Deploy auth-send-email + send-email, enable Auth Send Email hook
# See supabase/functions/env.example

# Realtime collaboration (optional — shared pages with editor/admin access)
# Frontend (Vercel): WebSocket URL of the Hocuspocus server
# VITE_COLLAB_URL=ws://localhost:1234
# VITE_COLLAB_URL=wss://collab.wings.nopejs.me
#
# Collab server (collab/ — deploy to Fly/Railway/Render with WebSocket support):
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   COLLAB_PORT=1234
#   COLLAB_ALLOWED_ORIGINS=https://wings.nopejs.me
# Dev collab example:
#   COLLAB_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
# Run locally: cd collab && npm install && npm run dev
# Then: supabase db push (applies content_yjs migration)
