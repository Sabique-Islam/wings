# Copy to supabase/functions/.env for local testing, then:
#   supabase secrets set --env-file supabase/functions/.env

# Resend API key — https://resend.com/api-keys
# Must be named RESEND_API_KEY (see https://resend.com/docs/send-with-nodejs)
RESEND_API_KEY=re_xxxxxxxx

# Verify domain first: https://resend.com/domains
# From addresses must use your verified domain (mail.wings.nopejs.me)
MAIL_FROM_AUTH=Wings <auth@mail.wings.nopejs.me>
MAIL_FROM_APP=Wings <hello@mail.wings.nopejs.me>
MAIL_REPLY_TO=hello@mail.wings.nopejs.me

SITE_URL=https://wings.nopejs.me

# Supabase Auth hook — Dashboard → Auth → Hooks → Send Email
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxx

# Auto-injected when deployed; set for local `supabase functions serve`
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Test addresses (no real inbox needed during dev):
#   delivered@resend.dev  bounced@resend.dev  complained@resend.dev
